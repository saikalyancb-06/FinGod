# Copy to .env (same folder) and fill in. .env is never committed.

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Smart Spending live search (SerpAPI) ---
SERP_API=
DEFAULT_LOCATION=Bengaluru, Karnataka, India

# --- Separate secrets per product (change for anything beyond local demo) ---
FINLENS_SECRET=change-me-finlens
MULE_SECRET=change-me-mule
FINLENS_DATA_KEY=change-me-finlens-data
MULE_DATA_KEY=change-me-mule-data

# --- Institutional demo investigator passwords (seeded on first start) ---
MULE_ANALYST_PASSWORD=analyst-demo-2026
MULE_LEAD_PASSWORD=lead-demo-2026

# --- Databases: SQLite by default; for PostgreSQL use e.g.
# FINLENS_DATABASE_URL=postgresql+psycopg2://finlens:pw@localhost:5432/finlens
# MULE_DATABASE_URL=postgresql+psycopg2://mule:pw@localhost:5432/mule

# --- Optional: existing CredWise loan-approval model API (historical-approval label; shown as a caveated side signal) ---
LOAN_API_BASE_URL=

# --- Sarvam AI: Hindi/Kannada translation + voice (speech-to-text, text-to-speech) ---
SARVAM_API_KEY=
